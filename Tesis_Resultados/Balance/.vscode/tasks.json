{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Balance agua_salada 10 px_mm",
      "type": "process",
      "command": "${env:TESIS_PYTHON}",
      "args": [
        "-u",
        "${workspaceFolder}/balance.py",
        "agua_salada",
        "--resolucion",
        "10"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OMP_NUM_THREADS": "1",
          "OPENBLAS_NUM_THREADS": "1"
        }
      },
      "problemMatcher": []
    },
